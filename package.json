{
  "name": "pi-diffwalk",
  "version": "0.0.0",
  "description": "Agent-guided code review for pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sukitly/pi-diffwalk.git"
  },
  "homepage": "https://github.com/Sukitly/pi-diffwalk#readme",
  "bugs": {
    "url": "https://github.com/Sukitly/pi-diffwalk/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "code-review"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && biome check --error-on-warnings .",
    "lint": "npm run check",
    "format": "biome format --write .",
    "release": "node scripts/release.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "ci": "npm run lint && npm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@types/node": "26.1.2",
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "diff": "9.0.0"
  }
}
